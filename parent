package abcd;

public class parent {
	private int a;
	public int getA() {
		return a;
	}
	public void setA(int a) {
		this.a = a;
	}
}

class Demo extends parent {

	public static void main(String[] args) {
		Demo bb = new Demo();
		bb.setA(7);
		int ss = bb.getA();
		System.out.println(ss);
	}

}

